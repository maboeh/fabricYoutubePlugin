{
  "name": "youtube-to-fabric",
  "version": "1.0.0",
  "description": "Save YouTube videos as bookmarks to Fabric.so - Chrome & Safari Extension",
  "private": true,
  "type": "module",
  "scripts": {
    "build:chrome": "bash scripts/build-chrome.sh",
    "build:safari": "bash scripts/build-safari.sh",
    "build": "npm run build:chrome && npm run build:safari",
    "xcode": "open 'safari-app/YouTube to Fabric/YouTube to Fabric.xcodeproj'",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node generate-icons.cjs",
    "pretest:e2e": "npm run build:chrome",
    "test:e2e": "playwright test --grep-invert @smoke",
    "test:e2e:smoke": "playwright test --grep @smoke"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.61.1",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "vitest": "^3.0.8"
  }
}
